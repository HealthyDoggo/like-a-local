# Database Configuration
DATABASE_URL=postgresql://travelbuddy:travelbuddy@localhost:5432/travelbuddy

# Wake-on-LAN Configuration
PC_MAC_ADDRESS=00:11:22:33:44:55
PC_IP_ADDRESS=192.168.1.100
PC_PORT=9

# Processing Schedule (Cron format)
PROCESSING_SCHEDULE=0 2 * * *

# Model Configuration
NLLB_MODEL_NAME=facebook/nllb-200-3.3B
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
MODEL_CACHE_DIR=./models
TARGET_LANGUAGE=eng_Latn

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=False

# Clustering/Promotion Configuration
# Cosine similarity threshold for clustering tips (0.0-1.0, higher = more similar required)
SIMILARITY_THRESHOLD=0.85
# Minimum number of mentions required to promote a tip
MIN_MENTIONS=3

# JWT Configuration
# Generate with: openssl rand -base64 32
JWT_SECRET_KEY=your-256-bit-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth Configuration
# Get these from Google Cloud Console: https://console.cloud.google.com
# Navigate to: APIs & Services > Credentials
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
